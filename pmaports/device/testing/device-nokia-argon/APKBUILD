# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-nokia-argon
pkgdesc="Nokia 8110 4G"
pkgver=10
pkgrel=7
url="https://postmarketos.org"
license="GPL-2.0-only"
arch="armv7"
options="!check !archcheck"
depends="
	bluez
	linux-postmarketos-qcom-msm8916
	mkbootimg
	nokia-bt-hfp
	postmarketos-base
	python3
	soc-qcom-msm8909
	soc-qcom-msm8916-rproc
"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-foot
"
makedepends="devicepkg-dev mipi-dbi-cmd"
_panel="nokia,argon-gc9305-v2-panel"
source="
	00-nokia-argon-display.files
	61-nokia-argon-keypad.hwdb
	deviceinfo
	foot.ini
	kernel-cmdline.conf
	modules-initfs
	nokia-argon-modules.conf
	nokia-argon-sway.conf
	sxmo_deviceprofile_nokia,argon.sh
	$_panel.txt
"

build() {
	devicepkg_build $startdir $pkgname
	mkdir -p "$builddir"
	mipi-dbi-cmd "$builddir"/"$_panel".bin \
			"$srcdir"/"$_panel".txt
}

package() {
	devicepkg_package $startdir $pkgname
	# Package display init sequence
	install -Dm644 "$builddir"/"$_panel".bin -t \
			"$pkgdir"/lib/firmware/
	install -Dm644 "$srcdir"/00-nokia-argon-display.files -t \
			"$pkgdir"/usr/share/mkinitfs/files/
	install -Dm644 "$srcdir"/nokia-argon-modules.conf \
			"$pkgdir"/etc/modules-load.d/nokia-argon.conf
	install -Dm644 "$srcdir"/61-nokia-argon-keypad.hwdb \
			"$pkgdir"/usr/lib/udev/hwdb.d/61-nokia-argon-keypad.hwdb
	install -Dm644 "$srcdir"/nokia-argon-sway.conf \
			"$pkgdir"/etc/sway/config.d/nokia-argon.conf
	install -Dm755 "$srcdir"/sxmo_deviceprofile_nokia,argon.sh \
			"$pkgdir"/usr/bin/sxmo_deviceprofile_nokia,argon.sh
}

foot() {
	install_if="$pkgname=$pkgver-r$pkgrel foot"
	replaces="foot"
	install -Dm644 "$srcdir"/foot.ini \
			"$subpkgdir"/etc/xdg/foot/foot.ini
}

nonfree_firmware() {
	pkgdesc="GPU/WiFi/BT/Modem/Video firmware"
	depends="
		firmware-qcom-adreno-a300
		msm-firmware-loader
		firmware-nokia-argon-venus
		firmware-nokia-argon-wcnss-nv
	"
	mkdir "$subpkgdir"
}

