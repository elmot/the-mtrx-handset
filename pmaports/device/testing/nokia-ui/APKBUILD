# Maintainer:
pkgname=nokia-ui
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal Python + Slint UI session for Nokia 8110 4G"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
options="!check"
depends="py3-slint sway"
source="
	main.py
	main.slint
	nokia-ui.conf
	nokia-ui.desktop
"
builddir="$srcdir"

package() {
	install -Dm755 "$builddir/main.py" \
		"$pkgdir/usr/share/nokia-ui/main.py"
	install -Dm644 "$builddir/main.slint" \
		"$pkgdir/usr/share/nokia-ui/main.slint"
	install -Dm644 "$builddir/nokia-ui.conf" \
		"$pkgdir/etc/sway/nokia-ui.conf"
	install -Dm644 "$builddir/nokia-ui.desktop" \
		"$pkgdir/usr/share/wayland-sessions/nokia-ui.desktop"
}
sha512sums="
