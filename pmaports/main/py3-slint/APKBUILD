# Maintainer:
pkgname=py3-slint
pkgver=1.10.0
pkgrel=1
pkgdesc="Python bindings for the Slint UI toolkit"
url="https://slint.dev/"
arch="armv7 aarch64 x86_64"
license="GPL-3.0-only"
depends="
	libxkbcommon
	mesa-egl
	python3
	wayland-libs-client
"
makedepends="
	cargo
	libxkbcommon-dev
	maturin
	mesa-dev
	py3-gpep517
	py3-installer
	python3-dev
	wayland-dev
"
options="!check net" # cargo fetches crates during build
source="slint-$pkgver.tar.gz::https://github.com/slint-ui/slint/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/slint-$pkgver"

build() {
	cd "$builddir/api/python"
	RUSTFLAGS="--cap-lints warn" maturin build \
		--release \
		--strip \
		--auditwheel=skip \
		--features backend-linuxkms \
		--out "$builddir/dist"
}

package() {
	python3 -m installer -d "$pkgdir" \
		"$builddir"/dist/*.whl
}

# Run `pmbootstrap checksum py3-slint` to populate sha512sums

sha512sums="
e7463771e4282238bdb6e1405c0fa3bf2231254457430e3cca743331d653b4bfb4da65b94f136ecbe13a89529f2ee27aadb3b799902db51a9a45a961d1d35b48  slint-1.10.0.tar.gz
"
