# Maintainer:
pkgname=nokia-bt-hfp
pkgver=0.1.0
pkgrel=11
pkgdesc="Nokia 8110 4G Bluetooth HFP-HF + Q6AFE INT_BT_SCO audio bridge with dual-mic noise cancellation"
url="https://postmarketos.org"
arch="armv7"
license="GPL-2.0-only"
options="!check"
depends="bluez libnotify pipewire pipewire-pulse pulseaudio-utils wireplumber"
makedepends="alsa-lib-dev glib-dev speexdsp-dev"
subpackages="$pkgname-openrc $pkgname-systemd"
install="$pkgname-openrc.post-install"
source="
	Makefile
	alsa_bridge.c
	alsa_bridge.h
	nokia_bt_hfp.c
	nokia-bt-hfp.initd
	nokia-bt-hfp-openrc.post-install
	nokia-bt-hfp.service
	85-nokia-bt-hfp.preset
	nokia-bt-hfp-dbus.conf
	50-nokia-bt-quantum.conf
	50-nokia-bluez-handset.conf
"
builddir="$srcdir"

build() {
	make CC="${CC:-gcc}"
}

package() {
	make DESTDIR="$pkgdir" install

	install -Dm644 "$builddir/nokia-bt-hfp-dbus.conf" \
		"$pkgdir/usr/share/dbus-1/system.d/nokia-bt-hfp.conf"

	install -Dm644 "$builddir/50-nokia-bt-quantum.conf" \
		"$pkgdir/usr/share/pipewire/pipewire.conf.d/50-nokia-bt-quantum.conf"

	install -Dm644 "$builddir/50-nokia-bluez-handset.conf" \
		"$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-nokia-bluez-handset.conf"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="bluez-openrc"
	install -Dm755 "$builddir/nokia-bt-hfp.initd" \
		"$subpkgdir/etc/init.d/nokia-bt-hfp"
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$builddir/nokia-bt-hfp.service" \
		"$subpkgdir/usr/lib/systemd/user/nokia-bt-hfp.service"

	install -Dm644 "$builddir/85-nokia-bt-hfp.preset" \
		"$subpkgdir/usr/lib/systemd/user-preset/85-nokia-bt-hfp.preset"

	install -dm755 "$subpkgdir/usr/lib/systemd/user/default.target.wants"
	ln -s ../nokia-bt-hfp.service \
		"$subpkgdir/usr/lib/systemd/user/default.target.wants/nokia-bt-hfp.service"
}
