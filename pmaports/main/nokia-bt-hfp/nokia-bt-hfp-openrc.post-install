#!/bin/sh
rc-update add bluetooth default >/dev/null 2>&1 || true
rc-update add pipewire default >/dev/null 2>&1 || true
rc-update add pipewire-pulse default >/dev/null 2>&1 || true
rc-update add wireplumber default >/dev/null 2>&1 || true
rc-update add nokia-bt-hfp default >/dev/null 2>&1 || true
exit 0
