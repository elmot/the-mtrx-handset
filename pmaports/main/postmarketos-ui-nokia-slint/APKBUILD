# Maintainer:
pkgname=postmarketos-ui-nokia-slint
pkgver=0.1.0
pkgrel=7
pkgdesc="Minimal Python + Slint KMS/DRM UI for Nokia 8110 4G (OpenRC, no Wayland/X11/systemd)"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
options="!check pmb:drm"
depends="
	bind-tools
	bluez
	curl
	dnsmasq
	font-dejavu
	font-terminus
	iproute2
	iputils
	iw
	netcat-openbsd
	nokia-bt-hfp
	nokia-ui
	openssh-client
	polkit
	postmarketos-base-ui
	postmarketos-base-ui-audio
	postmarketos-base-ui-networkmanager
	tcpdump
	wget
	"
subpackages="$pkgname-openrc"
source="
	50-networkmanager.start
	10-networkmanager-plugdev.rules
	"
builddir="$srcdir"

package() {
	install -Dm644 "$builddir/10-networkmanager-plugdev.rules" \
		"$pkgdir/etc/polkit-1/rules.d/10-networkmanager-plugdev.rules"
}

openrc() {
	pkgdesc="$pkgdesc (openrc)"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="
		bluez-openrc
		networkmanager-openrc
		nokia-bt-hfp-openrc
		nokia-ui-openrc
		openrc
	"
	install -Dm755 "$builddir/50-networkmanager.start" \
		"$subpkgdir/etc/local.d/50-networkmanager.start"
}
sha512sums="
