e458f28ac9d1de8aa8bb7a51fac767d393f8640dc79045d97b185e618513131a29dfe2a558ac2e157e633054eec1f0ebc7805a99a3b780dd8d940052d4e9faf7  10-networkmanager-plugdev.rules
"
