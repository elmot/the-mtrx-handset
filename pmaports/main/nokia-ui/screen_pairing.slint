import { Theme, StatusBar, SoftkeyBar } from "ui_common.slint";

// Screen 6: Bluetooth Pairing Discovery (PAIRING_DISCOVERY_6B)
export component PairingDiscoveryScreen inherits Rectangle {
    in property <string> device-name: "BananaPhone";
    in property <bool> timed-out: false;
    in property <int> battery-percent: 85;

    callback retry-pair-clicked();
    callback back-clicked();

    width: 240px;
    height: 320px;
    background: Theme.bg;

    VerticalLayout {
        StatusBar {
            status-text: "PAIRING";
            status-color: root.timed-out ? Theme.warning : Theme.accent;
            battery-percent: root.battery-percent;
        }

        // Main Viewport
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: center;

                if !root.timed-out: VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Discoverable as:";
                        color: Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.accent;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\"" + root.device-name + "\"";
                            color: Theme.accent;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Waiting for phone...";
                        color: Theme.text-primary;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }

                if root.timed-out: VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: "Pairing timed out.";
                        color: Theme.warning;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Press Pair to retry.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        SoftkeyBar {
            left-label: root.timed-out ? "PAIR" : "(Pair)";
            right-label: "BACK";
            left-enabled: root.timed-out;
            left-color: Theme.accent;
            right-color: Theme.text-primary;
            left-clicked => { root.retry-pair-clicked(); }
            right-clicked => { root.back-clicked(); }
        }
    }
}
