import { Theme, StatusBar, SoftkeyBar } from "ui_common.slint";

// Screen 2: Incoming Call Screen (INCOMING_CALL)
export component IncomingCallScreen inherits Rectangle {
    in property <string> caller-id: "Unknown";
    in property <bool> ring-silenced: false;
    in property <int> battery-percent: 85;

    callback answer-clicked();
    callback reject-clicked();

    width: 240px;
    height: 320px;
    background: Theme.bg;

    VerticalLayout {
        StatusBar {
            status-text: "INCOMING CALL";
            status-color: Theme.success;
            battery-percent: root.battery-percent;
        }

        // Main Viewport
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                alignment: center;

                // Handset ring icon
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 60px;
                        height: 60px;
                        border-radius: 30px;
                        background: Theme.surface;
                        border-width: 2px;
                        border-color: Theme.success;

                        Path {
                            x: 16px;
                            y: 16px;
                            width: 28px;
                            height: 28px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 6.6 10.8 C 8.0 13.6 10.4 16.0 13.2 17.4 L 15.4 15.2 C 15.7 14.9 16.1 14.8 16.5 14.9 C 17.7 15.3 19.0 15.5 20.3 15.5 C 20.9 15.5 21.3 16.0 21.3 16.5 L 21.3 20.0 C 21.3 20.6 20.9 21.0 20.3 21.0 C 10.7 21.0 3.0 13.3 3.0 3.7 C 3.0 3.1 3.4 2.7 4.0 2.7 L 7.5 2.7 C 8.0 2.7 8.5 3.1 8.5 3.7 C 8.5 5.0 8.7 6.3 9.1 7.5 C 9.2 7.9 9.1 8.3 8.8 8.6 L 6.6 10.8 Z";
                            fill: Theme.success;
                        }
                    }
                }

                Text {
                    text: root.ring-silenced ? "RING SILENCED" : "*** RINGING ***";
                    color: root.ring-silenced ? Theme.text-muted : Theme.warning;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    letter-spacing: 1px;
                }

                Rectangle {
                    height: 54px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.caller-id != "" ? root.caller-id : "Unknown Caller";
                        color: Theme.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        SoftkeyBar {
            left-label: "ANSWER";
            right-label: "REJECT";
            left-color: Theme.success;
            right-color: Theme.danger;
            left-clicked => { root.answer-clicked(); }
            right-clicked => { root.reject-clicked(); }
        }
    }
}
