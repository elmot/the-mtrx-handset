# Maintainer:
pkgname=nokia-ui
pkgver=0.1.0
pkgrel=12
pkgdesc="Minimal Python + Slint KMS/DRM UI for Nokia 8110 4G"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
options="!check"
depends="dbus font-dejavu font-terminus py3-slint"
subpackages="$pkgname-openrc"
install="$pkgname-openrc.post-install"
source="
	main.py
	main.slint
	main_view.slint
	ui_common.slint
	screen_home.slint
	screen_incoming_call.slint
	screen_active_call.slint
	screen_call_ended.slint
	screen_unpair.slint
	screen_pairing.slint
	screen_power_off.slint
	nokia-ui.initd
	nokia-ui-openrc.post-install
"
builddir="$srcdir"

package() {
	install -Dm755 "$builddir/main.py" \
		"$pkgdir/usr/share/nokia-ui/main.py"
	for _f in "$builddir"/*.slint; do
		install -Dm644 "$_f" \
			"$pkgdir/usr/share/nokia-ui/$(basename "$_f")"
	done
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install -Dm755 "$builddir/nokia-ui.initd" \
		"$subpkgdir/etc/init.d/nokia-ui"
	install -dm755 "$subpkgdir/etc/runlevels/default"
	ln -s /etc/init.d/nokia-ui \
		"$subpkgdir/etc/runlevels/default/nokia-ui"
}
