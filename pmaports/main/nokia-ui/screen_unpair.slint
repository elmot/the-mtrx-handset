import { Theme, StatusBar, SoftkeyBar } from "ui_common.slint";

// Screen 5: Bluetooth Unpair Confirmation (UNPAIR_CONFIRM_6A)
export component UnpairConfirmScreen inherits Rectangle {
    in property <string> paired-device-name: "Pixel 8 Pro";
    in property <int> battery-percent: 85;

    callback cancel-clicked();
    callback unpair-clicked();

    width: 240px;
    height: 320px;
    background: Theme.bg;

    VerticalLayout {
        StatusBar {
            status-text: "BLUETOOTH";
            status-color: Theme.accent;
            battery-percent: root.battery-percent;
        }

        // Main Viewport
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Paired to:";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.accent;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.paired-device-name != "" ? root.paired-device-name : "Bonded Device";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Text {
                    text: "Unpair to continue?";
                    color: Theme.warning;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }

        SoftkeyBar {
            left-label: "CANCEL";
            right-label: "UNPAIR";
            left-color: Theme.text-primary;
            right-color: Theme.danger;
            left-clicked => { root.cancel-clicked(); }
            right-clicked => { root.unpair-clicked(); }
        }
    }
}
