import { Theme, StatusBar, SoftkeyBar } from "ui_common.slint";

// Screen 7: Power Off Confirmation (POWER_OFF_DIALOG)
export component PowerOffScreen inherits Rectangle {
    in property <int> battery-percent: 85;

    callback yes-clicked();
    callback no-clicked();

    width: 240px;
    height: 320px;
    background: Theme.bg;

    VerticalLayout {
        StatusBar {
            status-text: "POWER OFF";
            status-color: Theme.danger;
            battery-percent: root.battery-percent;
        }

        // Main Viewport
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: Theme.surface;
                        border-width: 2px;
                        border-color: Theme.danger;

                        Path {
                            x: 16px;
                            y: 16px;
                            width: 24px;
                            height: 24px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 12 3 L 12 12 M 7.8 6.8 C 5.5 8.5 4.5 11.4 5.3 14.2 C 6.2 17.5 9.2 19.8 12.6 19.5 C 16.0 19.2 18.7 16.4 19.0 13.0 C 19.2 10.6 18.1 8.3 16.2 6.8";
                            stroke: Theme.danger;
                            stroke-width: 2.2px;
                        }
                    }
                }

                Text {
                    text: "Power off system?";
                    color: Theme.text-primary;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }

        SoftkeyBar {
            left-label: "YES";
            right-label: "NO";
            left-color: Theme.danger;
            right-color: Theme.text-primary;
            left-clicked => { root.yes-clicked(); }
            right-clicked => { root.no-clicked(); }
        }
    }
}
