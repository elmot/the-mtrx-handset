import { ScreenId, MainView } from "main_view.slint";
export { ScreenId }

export component MainWindow inherits Window {
    width: 240px;
    height: 320px;
    background: #000000;

    // Active state
    in-out property <ScreenId> active-screen <=> view.active-screen;

    // Shared device / telephony state
    in-out property <bool> bt-connected <=> view.bt-connected;
    in-out property <string> paired-device-name <=> view.paired-device-name;
    in-out property <string> local-bt-name <=> view.local-bt-name;
    in-out property <bool> slider-open <=> view.slider-open;
    in-out property <int> battery-percent <=> view.battery-percent;

    // Call state
    in-out property <string> caller-id <=> view.caller-id;
    in-out property <bool> ring-silenced <=> view.ring-silenced;
    in-out property <bool> speaker-mode <=> view.speaker-mode;
    in-out property <int> volume-percent <=> view.volume-percent;

    // Pairing state
    in-out property <bool> pairing-timed-out <=> view.pairing-timed-out;

    // Hardware / softkey callbacks for Python state machine
    callback soft-left <=> view.soft-left;
    callback soft-right <=> view.soft-right;
    callback pickup-pressed <=> view.pickup-pressed;
    callback hangup-pressed <=> view.hangup-pressed;
    callback vol-up <=> view.vol-up;
    callback vol-down <=> view.vol-down;

    forward-focus: view;
    view := MainView {}
}
