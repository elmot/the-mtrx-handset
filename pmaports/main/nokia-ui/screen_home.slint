import { Theme, StatusBar, SoftkeyBar } from "ui_common.slint";

// Screen 1: Home / Idle Screen (HOME_IDLE)
export component HomeScreen inherits Rectangle {
    in property <bool> bt-connected: false;
    in property <string> paired-device-name: "";
    in property <bool> slider-open: true;
    in property <int> battery-percent: 85;

    callback pair-clicked();
    callback off-clicked();

    width: 240px;
    height: 320px;
    background: Theme.bg;

    VerticalLayout {
        StatusBar {
            status-text: root.bt-connected ? "CONNECTED" : "DISCONNECTED";
            status-color: root.bt-connected ? Theme.success : Theme.warning;
            battery-percent: root.battery-percent;
        }

        // Main Viewport
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                alignment: center;

                // Bluetooth status icon
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: Theme.surface;
                        border-width: 2px;
                        border-color: root.bt-connected ? Theme.success : Theme.border;

                        Path {
                            x: 16px;
                            y: 12px;
                            width: 24px;
                            height: 32px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 12 2 L 18 7 L 12 12 L 18 17 L 12 22 L 12 2 M 6 7 L 18 17 M 6 17 L 18 7";
                            stroke: root.bt-connected ? Theme.success : Theme.text-muted;
                            stroke-width: 2px;
                        }
                    }
                }

                Text {
                    text: "READY";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    letter-spacing: 1.5px;
                }

                if root.paired-device-name != "": Text {
                    text: root.paired-device-name;
                    color: root.bt-connected ? Theme.accent : Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                // Slider state pill
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 150px;
                        height: 28px;
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: root.slider-open ? "SLIDER: OPEN" : "SLIDER: CLOSED";
                            color: root.slider-open ? Theme.accent : Theme.text-muted;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        SoftkeyBar {
            left-label: "PAIR";
            right-label: "OFF";
            left-color: Theme.accent;
            right-color: Theme.text-primary;
            left-clicked => { root.pair-clicked(); }
            right-clicked => { root.off-clicked(); }
        }
    }
}
